{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "akdftest"
		},
		"AzureDataLakeStorageTest_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorageTest'"
		},
		"Snowflake_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Snowflake'"
		},
		"AzureDataLakeStorageTest_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlssaccountak.dfs.core.windows.net/"
		},
		"Snowflake_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "SALES_MART"
		},
		"Snowflake_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "akdftest_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorageTest_accountKey": {
						"value": "[parameters('AzureDataLakeStorageTest_accountKey')]"
					},
					"Snowflake_password": {
						"value": "[parameters('Snowflake_password')]"
					},
					"AzureDataLakeStorageTest_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorageTest_properties_typeProperties_url')]"
					},
					"Snowflake_properties_typeProperties_database": {
						"value": "[parameters('Snowflake_properties_typeProperties_database')]"
					},
					"Snowflake_properties_typeProperties_role": {
						"value": "[parameters('Snowflake_properties_typeProperties_role')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}